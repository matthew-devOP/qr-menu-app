# =====================================================
# QR Menu App - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# =====================================================

# -----------------------------------------------------
# Database Configuration
# -----------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_menu_app"
#
# Cloud options:
# - Supabase: https://supabase.com (free tier available)
# - Railway: https://railway.app (free tier available)
# - Neon: https://neon.tech (free tier available)
#
DATABASE_URL="postgresql://user:password@localhost:5432/qr_menu_app"

# -----------------------------------------------------
# Application Configuration
# -----------------------------------------------------
# Base URL for the application (used in QR codes, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application name (displayed in UI)
NEXT_PUBLIC_APP_NAME="INFINITY LOUNGE"

# Node environment (development, production, test)
NODE_ENV="development"

# -----------------------------------------------------
# NextAuth.js (Authentication)
# -----------------------------------------------------
# URL where NextAuth is running
NEXTAUTH_URL="http://localhost:3000"

# Secret key for JWT tokens and encryption
# Generate with: openssl rand -base64 32
# IMPORTANT: Change this in production!
NEXTAUTH_SECRET="your-secret-key-here-change-in-production-generate-with-openssl"

# -----------------------------------------------------
# Cloudinary (Image Storage & Optimization)
# -----------------------------------------------------
# Sign up at: https://cloudinary.com (free tier: 25 credits/month)
#
# Find your credentials at:
# Dashboard > Settings > Account
#
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: Cloudinary folder structure
CLOUDINARY_FOLDER="qr-menu-app"

# -----------------------------------------------------
# Optional: Error Tracking (Sentry)
# -----------------------------------------------------
# Sign up at: https://sentry.io (free tier available)
# Monitors errors and performance in production
#
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# -----------------------------------------------------
# Optional: Analytics
# -----------------------------------------------------
# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# -----------------------------------------------------
# Optional: Email Service (for notifications)
# -----------------------------------------------------
# For sending admin notifications, password resets, etc.
# Options: SendGrid, Mailgun, Resend, etc.
#
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="noreply@infinitylounge.ro"

# -----------------------------------------------------
# Optional: Redis (for caching)
# -----------------------------------------------------
# For API response caching and session storage
# Options: Upstash, Redis Cloud, local Redis
#
# REDIS_URL="redis://localhost:6379"
# REDIS_TOKEN="your-redis-token"

# -----------------------------------------------------
# Development Only
# -----------------------------------------------------
# Enable Prisma debug logging
# DEBUG="prisma:query"

# Disable Next.js telemetry
# NEXT_TELEMETRY_DISABLED="1"
